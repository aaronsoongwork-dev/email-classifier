# Copy this file to ".env" (same folder) and edit. NEVER commit .env (it is git-ignored).

# mock       = offline fake "LLM", no key needed (default; good for Stage 1 and the tests)
# anthropic  = Claude API    (pip install anthropic, set ANTHROPIC_API_KEY)
# openai     = OpenAI API    (pip install openai, set OPENAI_API_KEY)
#              also works with Ollama / any OpenAI-compatible server, see OPENAI_BASE_URL
LLM_PROVIDER=mock

# Leave LLM_MODEL empty for the default (anthropic: claude-haiku-5-5, openai: gpt-4o-mini).
# If you get "model not found", look up a current model name in your provider's docs.
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Day 3 idea: run a local model with Ollama and point the openai provider at it:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Below this confidence an email goes to the "needs_review" bucket.
CONFIDENCE_THRESHOLD=0.6

LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Optional: price per MILLION tokens (from your provider's pricing page) to see $ in `compare`.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
